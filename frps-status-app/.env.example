# 应用 HTTP 监听地址（容器内）；与 docker-compose 中 ports 的容器端口一致
LISTEN=0.0.0.0:8080
# 宿主机绑定地址（仅 docker-compose 使用，传给 ports 左端）
STATUS_APP_BIND=127.0.0.1
# 宿主机映射端口（仅 docker-compose 使用）
STATUS_APP_PORT=28080
# 数据库 /data/frps-status.sqlite、配置 /config/app-settings.yml、日志 /logs 分别对应 ./data、./config、./logs 挂载
# 可选：非空时覆盖默认日志目录 /logs
# LOG_DIR=
# frps 服务主机名或 IP（容器网络内常为服务名 frps）
FRPS_HOST=frps
# frps 客户端连接端口（与 frps 的 bind_port 一致）
FRPS_BIND_PORT=7000
# frps Dashboard HTTP 端口
FRPS_DASHBOARD_PORT=7500
# frps Dashboard 登录用户名
FRPS_DASHBOARD_USER=admin
# frps Dashboard 登录密码
FRPS_DASHBOARD_PASSWORD=123456
# 对外域名列表，逗号分隔；用于证书到期等提示（可为空）
STATUS_DOMAINS=example.com
# 状态面板登录固定为 admin / admin123（程序内置，不可通过环境变量修改）
# 轮询 frps Dashboard 的间隔（秒）
POLL_SECONDS=60
# 证书：compose 固定将 ./frps/certbot/conf 挂载为容器内 /etc/letsencrypt；应用固定读 /etc/letsencrypt/live
# 宿主机公网 IP（可选；留空则尝试自动探测，用于展示或告警）
HOST_PUBLIC_IP=
# 宿主机用于采集网卡流量的网卡名（如 eth0）
HOST_IFACE=eth0
# 容器内网卡统计挂载点（应用读取路径，需与 volumes 右端一致）
HOST_NET_STATS_DIR=/host-net-stats
# 宿主机网卡 statistics 目录（仅 docker-compose 挂载左端）
HOST_NET_STATS_MOUNT=/sys/class/net/eth0/statistics
